MONGO_URL="mongodb://localhost:27017"
DB_NAME="wassilha"
CORS_ORIGINS="http://localhost:3000"
# In production use only HTTPS origins, e.g. https://app.example.com
JWT_SECRET="replace-with-a-random-64-char-hex-secret"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me"
# Emergent Universal LLM key (works with OpenAI / Anthropic / Gemini). Leave empty to disable AI.
EMERGENT_LLM_KEY=""
AI_PROVIDER="openai"
AI_MODEL="gpt-5.4"

# Fernet key for application-level encryption of stored AI provider credentials. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY="replace-with-a-fernet-key"
